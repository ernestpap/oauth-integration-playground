# Copy this file to .env and fill in the real values.
# .env is ignored by git. Never commit it.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# The redirect URI must match what you registered there, exactly.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8010/api/google/callback/

# api.slack.com/apps -> your app -> Basic Information -> App Credentials
# The redirect URL must match OAuth & Permissions -> Redirect URLs, exactly.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:8010/api/slack/callback/

# Which timezone the times you type into the form are in (IANA name).
CALENDAR_TIMEZONE=UTC

# Where the React dev server runs. Used for CORS and for redirects back.
FRONTEND_URL=http://localhost:5173
